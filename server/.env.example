# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。
#
# === 火山方舟（豆包）文本模型 ===
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=ep-xxxxxxxxxxxxxx-xxxxx

# Embedding 走本地 BGE，无需配置（保留字段以备未来切线上）
ARK_EMBED_MODEL=

# === 多模态视觉模型（可选，未配置则禁用 /chat/stream/multimodal） ===
# 火山方舟控制台 → 在线推理 → 创建接入点 → 选 Doubao-1.5-Vision-Pro → 拿 ep-xxx
ARK_VISION_MODEL=
# 若视觉 endpoint 与文本 endpoint 在不同账号下，填该账号的 API Key；
# 留空则复用 ARK_API_KEY。
ARK_VISION_API_KEY=

# === 火山引擎语音识别（ASR，可选；未配置则禁用 /asr 接口） ===
# 走独立网关 openspeech.bytedance.com，与 Ark 不共账号。
# 控制台：https://console.volcengine.com/speech/app → 豆包·语音识别 → 创建应用 → API Key 管理
# 实际接口走 /api/v1/auc/submit + /query 提交-轮询模式，仅需单 x-api-key
VOLC_ASR_API_KEY=

# === 服务监听 ===
HOST=0.0.0.0
PORT=8000

# === 向量库本地存储路径（相对 server/）===
CHROMA_DIR=./chroma_db
